{
  "build": {
    "beforeDevCommand": "npm run pdf:worker && npm run dev",
    "beforeBuildCommand": "npm run pdf:worker && npm run build:desktop"
  },
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/MathLoop/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "resources": {
      "../public/books/": "books/",
      "../public/books.json": "books.json",
      "resources/pdf-import-worker/": "resources/pdf-import-worker/"
    },
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
